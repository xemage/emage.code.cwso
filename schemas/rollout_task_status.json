{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwso.dev/schemas/rollout_task_status.json",
  "title": "rollout_task_status",
  "description": "Poll response for GET /rollout/task/{task_id}. Returns rollout progress, partial results, and trajectory groups.",
  "type": "object",
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed", "cancelled"]
    },
    "partial_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer", "minimum": 0 },
          "reward": { "type": "number" },
          "merge_outcome": {
            "type": "string",
            "enum": ["success", "conflict", "syntax_fail", "pending"]
          }
        },
        "required": ["step", "reward", "merge_outcome"]
      }
    },
    "trajectories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chain_id": { "type": "string", "format": "uuid" },
          "loss_mask_token_count": { "type": "integer", "minimum": 0 },
          "total_reward": { "type": "number" }
        },
        "required": ["chain_id", "loss_mask_token_count"]
      }
    },
    "error": { "type": "string" }
  },
  "required": ["task_id", "status"],
  "additionalProperties": false
}
