{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwso.dev/schemas/query_ast.json",
  "title": "query_ast",
  "type": "object",
  "properties": {
    "workspace_uuid": { "type": "string" },
    "path": { "type": "string" },
    "query_type": {
      "type": "string",
      "enum": ["find_definition", "find_references", "extract_signature", "list_exports", "detect_entrypoints"]
    },
    "target_symbol": { "type": "string" }
  },
  "required": ["workspace_uuid", "path", "query_type"]
}
