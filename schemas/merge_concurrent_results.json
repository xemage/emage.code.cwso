{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwso.dev/schemas/merge_concurrent_results.json",
  "title": "merge_concurrent_results",
  "type": "object",
  "properties": {
    "source_workspace_uuids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "format": "uuid" }
    },
    "target_branch_ref": { "type": "string", "default": "main" },
    "auto_resolve_heuristic": {
      "type": "string",
      "enum": ["ast_semantic_only", "prefer_theirs", "prefer_ours", "fail_rapidly_on_conflict"],
      "default": "ast_semantic_only"
    },
    "merge_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "language": {
            "type": "string",
            "enum": ["go", "rust", "python", "typescript"]
          },
          "base_content": { "type": "string" },
          "ours_content": { "type": "string" },
          "theirs_content": { "type": "string" }
        },
        "required": ["path", "language", "base_content", "ours_content", "theirs_content"],
        "additionalProperties": false
      }
    }
  },
  "required": ["source_workspace_uuids"],
  "additionalProperties": false
}
