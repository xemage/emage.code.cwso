# CWSO "all features on" orchestrator flags (local PoC).
# Copy: cp scripts/cwso-enable-all-features.env.example deploy/cwso-all-features.env
# Source: source scripts/cwso-enable-all-features.sh

# --- Phase 6: Hardware dispatch ---
CWSO_HHD_CAPABILITY_REGISTRY_ENABLED=true
CWSO_HHD_DECISION_TELEMETRY_ENABLED=true
CWSO_HHD_TELEMETRY_REDACTION_ENABLED=true
CWSO_HHD_POLICY_ENGINE_V2_ENABLED=true
CWSO_HHD_HARDWARE_AWARE_DISPATCH_ENABLED=true
CWSO_HHD_EVENT_MONITOR_ENABLED=true
CWSO_HHD_EVENT_MONITOR_EBPF_ENABLED=false
CWSO_HAL_SOCKET=/run/cwso/hal.sock

# --- Phase 7: Sparse + spikes ---
CWSO_SPARSE_AGENTS_ENABLED=true
CWSO_SPARSE_SOCKET=/run/cwso/sparse.sock
CWSO_SPARSE_QUALITY_GUARDRAIL_ENABLED=true
CWSO_AST_SPIKE_MONITOR_ENABLED=true
CWSO_AST_SPIKE_RESOURCES_ENABLED=true

# --- Phase 9: Rollout / Polar ---
CWSO_ROLLOUT_API_ENABLED=true
CWSO_ROLLOUT_REWARD_ENABLED=true
CWSO_ROLLOUT_KV_PREFIX_ROUTER_ENABLED=true
CWSO_ROLLOUT_SOCKET=/run/cwso/rollout.sock

# Sidecar proxy (cwso-rollout container — set when sidecar is attached)
CWSO_ROLLOUT_PROXY_ENABLED=true
CWSO_ROLLOUT_HTTP_BIND=127.0.0.1:8787
CWSO_ROLLOUT_UPSTREAM_URL=http://127.0.0.1:8000

# Optional assists (require extra assets/backends)
CWSO_HHD_SPARSE_QUANTIZED_ASSIST_ENABLED=false
CWSO_HHD_SSM_ASSIST_ENABLED=false
CWSO_HHD_WASM_SCORING_ENABLED=false
