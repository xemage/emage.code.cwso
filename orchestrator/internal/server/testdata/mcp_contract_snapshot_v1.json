    },
    "resources/unsubscribe": {
      "category": "error",
      "errorCode": -32601
    },
    "roots/list": {
      "category": "error",
      "errorCode": -32601
    },
    "sampling/createMessage": {
      "category": "error",
      "errorCode": -32601
    },
    "tools/call": {
      "category": "success",
      "resultShape": {
        "content": [
          {
            "text": "string",
            "type": "string"
          }
        ]
      }
    },
    "tools/call#tool-level-error": {
      "category": "success",
      "resultShape": {
        "content": [
          {
            "text": "string",
            "type": "string"
          }
        ],
        "isError": "boolean"
      }
    },
    "x-snapshot-canary/unknown": {
      "category": "error",
      "errorCode": -32601
    }
  },
  "notifications": {
    "recognized": [
      "notifications/initialized"
    ],
    "neverEmitted": [
      "notifications/cancelled",
      "notifications/message",
      "notifications/progress",
      "notifications/prompts/list_changed",
      "notifications/resources/list_changed",
      "notifications/resources/updated",
      "notifications/roots/list_changed",
      "notifications/tools/list_changed"
    ]
  },
