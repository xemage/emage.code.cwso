{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions/coding-standards.md",
    "instructions/git-workflow.md",
    "instructions/security-guidelines.md",
    "instructions/poc-guidelines.md"
  ],
  "mcp": {
    "gitlab": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "environment": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "{env:GITLAB_API_URL}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-fetch-server"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "brave": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "hf-mcp-server": {
      "type": "remote",
      "url": "https://huggingface.co/mcp?login"
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@anthropic/mcp-filesystem"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@github/mcp-github"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/mcp-git"
      ]
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp"
      ]
    },
    "e2b": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "e2b-mcp"
      ]
    },
    "docker": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "docker-mcp"
      ]
    },
    "redis": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "redis-mcp"
      ]
    },
    "postgresql": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "postgres-mcp"
      ]
    },
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@figma/mcp"
      ]
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notion/mcp"
      ]
    },
    "toolradar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "toolradar-mcp"
      ],
      "environment": {
        "TOOLRADAR_API_KEY": "{env:TOOLRADAR_API_KEY}"
      }
    }
  }
}
