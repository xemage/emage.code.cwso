# syntax=docker/dockerfile:1.6@sha256:ac85f380a63b13dfcefa89046420e1781752bab202122f8f50032edf31be0021
# cwso-git-shadow — Phase 2 sidecar (libgit2 + tree-sitter)
FROM rust:1.99.1-slim-trixie@sha256:b8e062b1c3a80183df83d9ba187cadd2b5ab84bc78d453dbfeb2fccd5f982247 AS builder
LABEL cwso=dev
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY services/Cargo.toml services/Cargo.lock ./
COPY services/cwso-git-shadow ./cwso-git-shadow
COPY services/cwso-merge-engine ./cwso-merge-engine
COPY services/cwso-hal ./cwso-hal
COPY services/cwso-sparse ./cwso-sparse
COPY services/cwso-rollout ./cwso-rollout
RUN cargo build --locked --release -p cwso-git-shadow

FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
# trixie-slim no longer ships adduser; install it so addgroup/adduser give
# the same system ids as on bookworm (cwso uid=100 gid=101, checked T728).
RUN apt-get update && apt-get install -y --no-install-recommends adduser ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /run/cwso /var/lib/cwso/shadow && \
    addgroup --system cwso && adduser --system --ingroup cwso cwso && \
    chown -R cwso:cwso /run/cwso /var/lib/cwso
COPY --from=builder /src/target/release/cwso-git-shadow /usr/local/bin/
USER cwso
ENV CWSO_GIT_SHADOW_SOCKET=/run/cwso/git-shadow.sock \
    CWSO_GIT_SHADOW_STORAGE=/var/lib/cwso/shadow \
    RUST_LOG=info
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cwso-git-shadow"]
