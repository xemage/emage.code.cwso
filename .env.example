# Example dev env vars. Copy to .env.dev and edit. NEVER commit real secrets.
# CWSO_JWT_SECRET must be at least 32 random bytes; rotate weekly in dev.
CWSO_JWT_SECRET=change-me-to-32-random-bytes-min-len-x
CWSO_TRANSPORT=http
CWSO_HTTP_ADDR=:8080
CWSO_LOG_LEVEL=info
CWSO_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CWSO_WORKSPACE=/workspace
